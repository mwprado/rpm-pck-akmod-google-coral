From: Moacyr Prado <mwprado@github>
Subject: [PATCH 5/5] kernel events: clear kernel eventfd bindings before close

KernelEventHandlerLinux::ReleaseEventFd() only closes the userspace eventfd.
The Gasket driver keeps its own eventfd_ctx reference after
GASKET_IOCTL_SET_EVENTFD and releases that reference only when
GASKET_IOCTL_CLEAR_EVENTFD is issued or when interrupt state is torn down.

Closing the userspace descriptor without clearing the Gasket binding leaves a
stale kernel reference between runtime close/open cycles. The fd argument to
ReleaseEventFd() was previously unused even though it is exactly the device fd
required for the clear ioctl.

Clear the interrupt/eventfd association first, then close the eventfd. Always
attempt the close even when the ioctl fails and return the accumulated status.

---
 driver/kernel/linux/kernel_event_handler_linux.cc | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/driver/kernel/linux/kernel_event_handler_linux.cc b/driver/kernel/linux/kernel_event_handler_linux.cc
--- a/driver/kernel/linux/kernel_event_handler_linux.cc
+++ b/driver/kernel/linux/kernel_event_handler_linux.cc
@@ -45,8 +45,22 @@ FileDescriptor KernelEventHandlerLinux::InitializeEventFd(int event_id) const {
 
 Status KernelEventHandlerLinux::ReleaseEventFd(FileDescriptor fd,
                                                FileDescriptor event_fd,
                                                int event_id) const {
-  close(event_fd);
-  return OkStatus();
+  Status status;
+
+  if (ioctl(fd, GASKET_IOCTL_CLEAR_EVENTFD, event_id) != 0) {
+    status.Update(FailedPreconditionError(
+        StringPrintf("Clearing Event Fd Failed: event_id=%d (%s)", event_id,
+                     strerror(errno))));
+  }
+
+  if (close(event_fd) != 0) {
+    status.Update(FailedPreconditionError(
+        StringPrintf("Closing Event Fd Failed: event_fd=%d (%s)", event_fd,
+                     strerror(errno))));
+  }
+
+  return status;
 }
 
 std::unique_ptr<KernelEvent> KernelEventHandlerLinux::CreateKernelEvent(
