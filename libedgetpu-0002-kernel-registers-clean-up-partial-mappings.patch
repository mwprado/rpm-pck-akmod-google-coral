From: Moacyr Prado <mwprado@github>
Subject: [PATCH 2/5] kernel registers: clean up partial mappings on failure

If mapping one register region succeeds and a later mmap fails,
KernelRegisters::Open() closes the file descriptor but leaves earlier mappings
active. A later Open() can overwrite those pointers and permanently leak the
old mappings.

Unmap all successfully mapped regions before closing the descriptor. Also fix
the inverted status check in UnmapAllRegions(), which currently logs successful
unmaps as errors while suppressing actual failures.

---
 driver/kernel/kernel_registers.cc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/driver/kernel/kernel_registers.cc b/driver/kernel/kernel_registers.cc
--- a/driver/kernel/kernel_registers.cc
+++ b/driver/kernel/kernel_registers.cc
@@ -54,7 +54,7 @@ void KernelRegisters::UnmapAllRegions() {
   for (auto& region : mmap_region_) {
     if (region.registers != nullptr) {
       status = UnmapRegion(fd_, region);
-      if (status.ok()) {
+      if (!status.ok()) {
         LOG(ERROR) << status;
       }
       region.registers = nullptr;
@@ -87,6 +87,7 @@ Status KernelRegisters::Open() {
 
     auto statusor = MapRegion(fd_, region, read_only_);
     if (!statusor.ok()) {
+      UnmapAllRegions();
       close(fd_);
       fd_ = INVALID_FD_VALUE;
       return statusor.status();
