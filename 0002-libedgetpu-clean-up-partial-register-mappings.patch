From: Moacyr Prado <mwprado@github>
Subject: [PATCH 2/5] libedgetpu: clean up partial register mappings on open failure

KernelRegisters::Open() can map several PCI BAR regions. If a later mmap()
fails, the code closes the fd but leaves all earlier mappings active and their
pointers stored in mmap_region_. Since fd_ is then marked invalid, the base
destructor will not call Close() and those mappings survive until process
teardown.

Unmap already-created regions before closing the descriptor. Also fix the
inverted status check in UnmapAllRegions(), which currently logs successful
unmaps as errors.

---
 driver/kernel/kernel_registers.cc | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/driver/kernel/kernel_registers.cc b/driver/kernel/kernel_registers.cc
--- a/driver/kernel/kernel_registers.cc
+++ b/driver/kernel/kernel_registers.cc
@@ -66,7 +66,7 @@ void KernelRegisters::UnmapAllRegions() {
   for (auto& region : mmap_region_) {
     if (region.registers != nullptr) {
       status = UnmapRegion(fd_, region);
-      if (status.ok()) {
+      if (!status.ok()) {
         LOG(ERROR) << status;
       }
       region.registers = nullptr;
@@ -100,9 +100,11 @@ Status KernelRegisters::Open() {
 
     auto statusor = MapRegion(fd_, region, read_only_);
     if (!statusor.ok()) {
+      Status map_status = statusor.status();
+      UnmapAllRegions();
       close(fd_);
       fd_ = INVALID_FD_VALUE;
-      return statusor.status();
+      return map_status;
     }
     region.registers = std::move(statusor.ValueOrDie());
     VLOG(3) << "Got map addr at 0x" << std::hex << region.registers;
