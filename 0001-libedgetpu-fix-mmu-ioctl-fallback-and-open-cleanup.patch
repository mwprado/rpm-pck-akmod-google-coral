From: Moacyr Prado <mwprado@github>
Subject: [PATCH 1/3] libedgetpu: fix MMU ioctl fallback and failed-open cleanup

Linux ioctl() returns -1 on failure and stores the error code in errno.
KernelMmuMapper compared the return value directly against -EPERM, -ENOTTY and
-EINVAL, so the intended fallback from GASKET_IOCTL_MAP_BUFFER_FLAGS to the
legacy GASKET_IOCTL_MAP_BUFFER path never triggered.

Also close the device fd when page-table partitioning fails during Open().
Without this cleanup the object remains in a partially-open state and leaks
the descriptor because its destructor is defaulted.

---
 driver/kernel/kernel_mmu_mapper.cc | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/driver/kernel/kernel_mmu_mapper.cc b/driver/kernel/kernel_mmu_mapper.cc
--- a/driver/kernel/kernel_mmu_mapper.cc
+++ b/driver/kernel/kernel_mmu_mapper.cc
@@ -14,6 +14,7 @@
 
 #include <fcntl.h>
 
+#include <cerrno>
 #include <sys/stat.h>
 #include <sys/types.h>
 
@@ -50,8 +51,13 @@ Status KernelMmuMapper::Open(int num_simple_page_table_entries_requested) {
   ioctl_buffer.size = num_simple_page_table_entries_requested;
 
   if (ioctl(fd_, GASKET_IOCTL_PARTITION_PAGE_TABLE, &ioctl_buffer) != 0) {
+    const int error = errno;
+    close(fd_);
+    fd_ = INVALID_FD_VALUE;
     return FailedPreconditionError(StringPrintf(
-        "Could not partition page table. : %d (%s)", fd_, strerror(errno)));
+        "Could not partition page table: %s", strerror(error)));
   }
 
   return Status();  // OK
@@ -100,12 +106,15 @@ Status KernelMmuMapper::DoMap(const void *buffer, int num_pages,
   int ioctl_retval = 0;
   if (map_flags_supported_) {
     ioctl_retval = ioctl(fd_, GASKET_IOCTL_MAP_BUFFER_FLAGS, &buffer_to_map);
-    if (ioctl_retval == -EPERM || ioctl_retval == -ENOTTY ||
-        ioctl_retval == -EINVAL) {
-      VLOG(4) << StringPrintf("Failed to map buffer with flags, error %d",
-                              ioctl_retval);
+    if (ioctl_retval != 0 &&
+        (errno == EPERM || errno == ENOTTY || errno == EINVAL)) {
+      const int error = errno;
+      VLOG(4) << StringPrintf(
+          "Failed to map buffer with flags, errno %d (%s); "
+          "falling back to legacy ioctl",
+          error, strerror(error));
       // This corresponds to an old kernel which doesn't yet support flags.
       // Set member variable to fallback to legacy IOCTL and try again.
       map_flags_supported_ = false;
     }
   }
