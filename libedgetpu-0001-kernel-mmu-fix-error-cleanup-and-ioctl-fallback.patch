From: Moacyr Prado <mwprado@github>
Subject: [PATCH 1/4] kernel mmu: fix failed-open cleanup and ioctl fallback

KernelMmuMapper::Open() leaves fd_ open when page-table partitioning fails.
The object then reports "Device already open" on a later retry and leaks the
descriptor until process exit.

DoMap() also compares ioctl()'s return value against -EPERM, -ENOTTY and
-EINVAL. Linux ioctl() returns -1 and reports the actual error through errno,
so the intended fallback to GASKET_IOCTL_MAP_BUFFER is never reached. Only
EINVAL/ENOTTY indicate an unavailable ioctl here; EPERM is a real Gasket
permission/state failure and must not be hidden by a legacy retry.

Close the device on partition failure and test errno when deciding whether the
flags ioctl is unsupported.

---
 driver/kernel/kernel_mmu_mapper.cc | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/driver/kernel/kernel_mmu_mapper.cc b/driver/kernel/kernel_mmu_mapper.cc
--- a/driver/kernel/kernel_mmu_mapper.cc
+++ b/driver/kernel/kernel_mmu_mapper.cc
@@ -43,8 +43,13 @@ Status KernelMmuMapper::Open(int num_simple_page_table_entries_requested) {
   ioctl_buffer.size = num_simple_page_table_entries_requested;
 
   if (ioctl(fd_, GASKET_IOCTL_PARTITION_PAGE_TABLE, &ioctl_buffer) != 0) {
+    const int saved_errno = errno;
+    close(fd_);
+    fd_ = INVALID_FD_VALUE;
     return FailedPreconditionError(StringPrintf(
-        "Could not partition page table. : %d (%s)", fd_, strerror(errno)));
+        "Could not partition page table: %s", strerror(saved_errno)));
   }
 
   return Status();  // OK
@@ -89,9 +94,10 @@ Status KernelMmuMapper::DoMap(const void *buffer, int num_pages,
   int ioctl_retval = 0;
   if (map_flags_supported_) {
     ioctl_retval = ioctl(fd_, GASKET_IOCTL_MAP_BUFFER_FLAGS, &buffer_to_map);
-    if (ioctl_retval == -EPERM || ioctl_retval == -ENOTTY ||
-        ioctl_retval == -EINVAL) {
-      VLOG(4) << StringPrintf("Failed to map buffer with flags, error %d",
-                              ioctl_retval);
+    if (ioctl_retval != 0 &&
+        (errno == ENOTTY || errno == EINVAL)) {
+      VLOG(4) << StringPrintf(
+          "Failed to map buffer with flags, errno %d (%s)", errno,
+          strerror(errno));
       // This corresponds to an old kernel which doesn't yet support flags.
       // Set member variable to fallback to legacy IOCTL and try again.
       map_flags_supported_ = false;
