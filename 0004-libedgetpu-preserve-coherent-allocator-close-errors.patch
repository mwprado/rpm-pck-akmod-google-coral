From: Moacyr Prado <mwprado@github>
Subject: [PATCH 4/5] libedgetpu: preserve coherent allocator close errors

KernelCoherentAllocator::DoClose() stores an error returned by Unmap(), but
returns a fresh OK status when the allocator-disable ioctl succeeds. This hides
the unmap failure.

If the disable ioctl itself fails, the function also returns before closing its
device fd. CoherentAllocator::Close() clears its state regardless of the
returned status, so that descriptor cannot be retried through the object and is
effectively leaked.

Preserve the accumulated status and always release the file descriptor.

---
 driver/kernel/kernel_coherent_allocator.cc | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/driver/kernel/kernel_coherent_allocator.cc b/driver/kernel/kernel_coherent_allocator.cc
--- a/driver/kernel/kernel_coherent_allocator.cc
+++ b/driver/kernel/kernel_coherent_allocator.cc
@@ -109,13 +109,12 @@
     status.Update(FailedPreconditionError(StringPrintf(
         "Could not disable coherent allocator size %" PRIu64 ". : %d (%s)",
         ioctl_buffer.size, fd_, strerror(errno))));
-    return status;
   }
 
   close(fd_);
   fd_ = INVALID_FD_VALUE;
   dma_address_ = 0;
-  return Status();  // OK
+  return status;
 }
 
 }  // namespace driver
